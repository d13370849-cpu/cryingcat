    </div>

    <!-- 圖片放大燈箱 (Lightbox Modal，支援前後張切換) -->
    <div class="lightbox-modal" id="lightboxModal" onclick="closeLightbox(event)">
        <button class="lightbox-close-btn" onclick="closeLightbox(event)" title="關閉預覽 (Esc)">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <button class="lightbox-nav-btn prev-btn" onclick="prevLightbox(event)" title="上一張 (方向鍵左)">
            <i class="fa-solid fa-chevron-left"></i>
        </button>
        <button class="lightbox-nav-btn next-btn" onclick="nextLightbox(event)" title="下一張 (方向鍵右)">
            <i class="fa-solid fa-chevron-right"></i>
        </button>
        <div class="lightbox-image-container">
            <img src="" alt="放大預覽" class="lightbox-img" id="lightboxImg">
            <div class="lightbox-caption-box">
                <div class="lightbox-caption-title" id="lightboxCaptionTitle"></div>
                <div class="lightbox-caption-desc" id="lightboxCaptionDesc"></div>
            </div>
        </div>
    </div>

    <!-- 複製成功提示 Toast -->
    <div class="toast-notification" id="toastNotification">
        <i class="fa-solid fa-circle-check"></i>
        <span id="toastText">已成功複製到剪貼簿！</span>
    </div>

    <!-- JavaScript 互動功能 -->
    <script>
        // === 1. 深色 / 淺色主題切換功能 ===
        const themeToggleBtn = document.getElementById('themeToggleBtn');
        const themeIcon = document.getElementById('themeIcon');
        const themeText = document.getElementById('themeText');

        const savedTheme = localStorage.getItem('user-theme') || 'dark';
        if (savedTheme === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
            themeIcon.className = 'fa-solid fa-sun';
            themeText.textContent = '切換深色模式';
        }

        themeToggleBtn.addEventListener('click', () => {
            const currentTheme = document.documentElement.getAttribute('data-theme');
            if (currentTheme === 'light') {
                document.documentElement.removeAttribute('data-theme');
                localStorage.setItem('user-theme', 'dark');
                themeIcon.className = 'fa-solid fa-moon';
                themeText.textContent = '切換淺色模式';
            } else {
                document.documentElement.setAttribute('data-theme', 'light');
                localStorage.setItem('user-theme', 'light');
                themeIcon.className = 'fa-solid fa-sun';
                themeText.textContent = '切換深色模式';
            }
        });

        // === 2. 點擊貓咪頭像趣味動畫 ===
        const avatarImage = document.getElementById('avatarImage');
        avatarImage.addEventListener('click', () => {
            avatarImage.style.transform = 'scale(1.2) rotate(15deg)';
            setTimeout(() => {
                avatarImage.style.transform = '';
            }, 300);
        });

        // === 3. 複製聯絡資訊功能與 Toast 提示 ===
        function copyContact(text, label) {
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text).then(() => {
                    showToast(`已成功複製${label}：${text}`);
                }).catch(() => {
                    fallbackCopy(text, label);
                });
            } else {
                fallbackCopy(text, label);
            }
        }

        function fallbackCopy(text, label) {
            const textArea = document.createElement("textarea");
            textArea.value = text;
            textArea.style.position = "fixed";
            textArea.style.opacity = "0";
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            try {
                document.execCommand('copy');
                showToast(`已成功複製${label}：${text}`);
            } catch (err) {
                alert(`請手動複製${label}：${text}`);
            }
            document.body.removeChild(textArea);
        }

        function showToast(message) {
            const toast = document.getElementById('toastNotification');
            const toastText = document.getElementById('toastText');
            toastText.textContent = message;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 2500);
        }

        // === 4. 精選作品分類篩選與圖片燈箱功能 ===
        const galleryItems = [
            {
                src: 'work1.jpg',
                title: '水光氛圍人像插畫',
                desc: '柔和水感光澤、髮絲流動感與周圍漂浮氣泡的折射光影呈現。'
            },
            {
                src: 'work2.png',
                title: '角色概念設定 ‧ 黑袍金邊少年',
                desc: '正背雙視圖完整設定，拆解黑金斗篷長袍、俐落剪裁長褲與細緻飾品。'
            },
            {
                src: 'work3.png',
                title: '角色概念設定 ‧ 藍斗篷馬尾少女',
                desc: '金黃馬尾搭配深藍斗篷短袍、綁帶長靴，呈現靈動活潑的冒險者風格。'
            },
            {
                src: 'work4.jpg',
                title: '概念插畫 ‧ 時空裂縫之門',
                desc: '透視動態構圖，少女伸展身姿穿越次元渦流，觸碰映照記憶的破裂晶石。'
            },
            {
                src: 'work5.png',
                title: '歐式宮廷貴族角色立繪',
                desc: '巴洛克緹花紋理燕尾服、精美藍底金絲背心與紳士手杖的全身精緻立繪。'
            }
        ];

        let currentLightboxIndex = 0;
        const lightboxModal = document.getElementById('lightboxModal');
        const lightboxImg = document.getElementById('lightboxImg');
        const lightboxCaptionTitle = document.getElementById('lightboxCaptionTitle');
        const lightboxCaptionDesc = document.getElementById('lightboxCaptionDesc');

        function updateLightboxView() {
            const item = galleryItems[currentLightboxIndex];
            if (!item) return;
            lightboxImg.src = item.src;
            lightboxCaptionTitle.textContent = item.title;
            lightboxCaptionDesc.textContent = item.desc;
        }

        function openLightboxByIndex(index) {
            currentLightboxIndex = index;
            updateLightboxView();
            lightboxModal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox(e) {
            if (e.target === lightboxModal || e.target.closest('.lightbox-close-btn')) {
                lightboxModal.classList.remove('active');
                document.body.style.overflow = '';
            }
        }

        function prevLightbox(e) {
            if (e) e.stopPropagation();
            currentLightboxIndex = (currentLightboxIndex - 1 + galleryItems.length) % galleryItems.length;
            updateLightboxView();
        }

        function nextLightbox(e) {
            if (e) e.stopPropagation();
            currentLightboxIndex = (currentLightboxIndex + 1) % galleryItems.length;
            updateLightboxView();
        }

        document.addEventListener('keydown', (e) => {
            if (!lightboxModal.classList.contains('active')) return;
            if (e.key === 'Escape') {
                lightboxModal.classList.remove('active');
                document.body.style.overflow = '';
            } else if (e.key === 'ArrowLeft') {
                prevLightbox();
            } else if (e.key === 'ArrowRight') {
                nextLightbox();
            }
        });

        // 分類過濾功能
        const filterBtns = document.querySelectorAll('.filter-btn');
        const cardElements = document.querySelectorAll('.gallery-card');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                const filter = btn.getAttribute('data-filter');

                cardElements.forEach(card => {
                    if (filter === 'all' || card.getAttribute('data-category') === filter) {
                        card.style.display = 'flex';
                        card.style.animation = 'fadeIn 0.4s ease-out';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });

        // ==========================================================================
        // === 5. 超互動隨手畫畫創作板引擎 (Interactive Doodle Studio Engine) ===
        // ==========================================================================
        (function () {
            const canvas = document.getElementById('doodleCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const guidePrompt = document.getElementById('canvasGuidePrompt');

            let isDrawing = false;
            let currentTool = 'pencil'; // pencil, neon, rainbow, eraser, stamp
            let currentColor = '#0f172a';
            let currentLineWidth = 5;
            let currentStamp = '🐾';
            let rainbowHue = 0;
            let lastX = 0;
            let lastY = 0;

            // 歷史紀錄堆疊 (支援復原 Undo)
            const historyStack = [];
            const maxHistory = 25;

            function saveHistory() {
                if (historyStack.length >= maxHistory) {
                    historyStack.shift();
                }
                historyStack.push(canvas.toDataURL('image/png'));
            }

            function undo() {
                if (historyStack.length === 0) {
                    showToast('目前沒有可復原的步驟');
                    return;
                }
                const prevData = historyStack.pop();
                const img = new Image();
                img.onload = () => {
                    const rect = canvas.getBoundingClientRect();
                    ctx.clearRect(0, 0, rect.width, rect.height);
                    ctx.drawImage(img, 0, 0, rect.width, rect.height);
                };
                img.src = prevData;
                showToast('已復原上一步驟');
            }

            // 初始化畫布尺寸與 High-DPI 適配
            function initDoodleSize() {
                const rect = canvas.getBoundingClientRect();
                if (rect.width === 0 || rect.height === 0) return;

                const dpr = Math.min(window.devicePixelRatio || 1, 2);
                const tempCanvas = document.createElement('canvas');
                tempCanvas.width = canvas.width;
                tempCanvas.height = canvas.height;
                const tempCtx = tempCanvas.getContext('2d');
                if (canvas.width > 0 && canvas.height > 0) {
                    tempCtx.drawImage(canvas, 0, 0);
                }

                canvas.width = rect.width * dpr;
                canvas.height = rect.height * dpr;
                ctx.scale(dpr, dpr);

                // 填入乾淨底色
                ctx.fillStyle = '#ffffff';
                ctx.fillRect(0, 0, rect.width, rect.height);

                if (tempCanvas.width > 0 && tempCanvas.height > 0) {
                    ctx.drawImage(tempCanvas, 0, 0, rect.width, rect.height);
                }

                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';
            }

            // 立即執行與監聽縮放
            initDoodleSize();
            window.addEventListener('resize', () => {
                setTimeout(initDoodleSize, 100);
            });

            // 座標計算 (支援跨設備滑鼠、觸控與觸控筆)
            function getCanvasCoords(e) {
                const rect = canvas.getBoundingClientRect();
                return {
                    x: e.clientX - rect.left,
                    y: e.clientY - rect.top
                };
            }

            // 隱藏歡迎引導提示
            function hideGuidePrompt() {
                if (guidePrompt && !guidePrompt.classList.contains('hidden')) {
                    guidePrompt.classList.add('hidden');
                }
            }

            // 開始繪圖 / 蓋章
            function handlePointerDown(e) {
                e.preventDefault();
                canvas.setPointerCapture(e.pointerId);
                hideGuidePrompt();
                saveHistory();

                const { x, y } = getCanvasCoords(e);
                lastX = x;
                lastY = y;

                // 若為印章模式：點擊即刻在座標蓋章
                if (currentTool === 'stamp') {
                    stampAt(x, y, currentStamp);
                    return;
                }

                isDrawing = true;
                applyBrushStyle();
                ctx.beginPath();
                ctx.moveTo(x, y);

                // 單次點擊也能留下圓點
                ctx.lineTo(x + 0.1, y + 0.1);
                ctx.stroke();
            }

            // 繪製路徑
            function handlePointerMove(e) {
                if (!isDrawing) return;
                e.preventDefault();
                const { x, y } = getCanvasCoords(e);

                if (currentTool === 'rainbow') {
                    rainbowHue = (rainbowHue + 4) % 360;
                    ctx.strokeStyle = `hsl(${rainbowHue}, 90%, 55%)`;
                }

                ctx.beginPath();
                ctx.moveTo(lastX, lastY);
                ctx.lineTo(x, y);
                ctx.stroke();

                lastX = x;
                lastY = y;
            }

            // 結束繪圖
            function handlePointerUp(e) {
                if (isDrawing) {
                    ctx.closePath();
                    isDrawing = false;
                }
                try {
                    canvas.releasePointerCapture(e.pointerId);
                } catch (err) { }
            }

            // 設定當前筆刷樣式
            function applyBrushStyle() {
                ctx.lineWidth = currentLineWidth;
                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';

                if (currentTool === 'eraser') {
                    ctx.strokeStyle = '#ffffff';
                    ctx.shadowBlur = 0;
                    ctx.shadowColor = 'transparent';
                } else if (currentTool === 'neon') {
                    ctx.strokeStyle = currentColor;
                    ctx.shadowBlur = Math.max(8, currentLineWidth * 2.2);
                    ctx.shadowColor = currentColor;
                } else if (currentTool === 'rainbow') {
                    ctx.strokeStyle = `hsl(${rainbowHue}, 90%, 55%)`;
                    ctx.shadowBlur = 8;
                    ctx.shadowColor = `hsl(${rainbowHue}, 90%, 55%)`;
                } else {
                    // 一般畫筆
                    ctx.strokeStyle = currentColor;
                    ctx.shadowBlur = 0;
                    ctx.shadowColor = 'transparent';
                }
            }

            // 繪製趣味印章
            function stampAt(x, y, emoji) {
                ctx.save();
                ctx.shadowBlur = 0;
                ctx.font = `${Math.max(24, currentLineWidth * 4)}px -apple-system, BlinkMacSystemFont, sans-serif`;
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(emoji, x, y);
                ctx.restore();
            }

            // 綁定現代 Pointer Events
            canvas.addEventListener('pointerdown', handlePointerDown);
            canvas.addEventListener('pointermove', handlePointerMove);
            canvas.addEventListener('pointerup', handlePointerUp);
            canvas.addEventListener('pointercancel', handlePointerUp);

            // --- 工具按鈕切換邏輯 ---
            const toolButtons = document.querySelectorAll('.tool-btn');
            const stampButtons = document.querySelectorAll('.stamp-btn');

            toolButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    toolButtons.forEach(b => b.classList.remove('active'));
                    stampButtons.forEach(s => s.classList.remove('active'));
                    btn.classList.add('active');
                    currentTool = btn.getAttribute('data-tool');
                    canvas.style.cursor = currentTool === 'eraser' ? 'cell' : 'crosshair';
                });
            });

            stampButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    toolButtons.forEach(b => b.classList.remove('active'));
                    stampButtons.forEach(s => s.classList.remove('active'));
                    btn.classList.add('active');
                    currentTool = 'stamp';
                    currentStamp = btn.getAttribute('data-stamp');
                    canvas.style.cursor = 'pointer';
                    showToast(`已選取印章「${currentStamp}」，點擊畫布即可蓋上！`);
                });
            });

            // --- 調色盤選擇 ---
            const colorDots = document.querySelectorAll('.color-dot');
            const customColor = document.getElementById('customColor');

            colorDots.forEach(dot => {
                dot.addEventListener('click', () => {
                    colorDots.forEach(d => d.classList.remove('active'));
                    dot.classList.add('active');
                    currentColor = dot.getAttribute('data-color');

                    // 若當前在橡皮擦或印章模式，點選顏色自動切換回畫筆模式
                    if (currentTool === 'eraser' || currentTool === 'stamp') {
                        const pencilBtn = document.getElementById('toolPencil');
                        if (pencilBtn) pencilBtn.click();
                    }
                    updateBrushPreview();
                });
            });

            if (customColor) {
                customColor.addEventListener('input', (e) => {
                    colorDots.forEach(d => d.classList.remove('active'));
                    currentColor = e.target.value;
                    if (currentTool === 'eraser' || currentTool === 'stamp') {
                        const pencilBtn = document.getElementById('toolPencil');
                        if (pencilBtn) pencilBtn.click();
                    }
                    updateBrushPreview();
                });
            }

            // --- 筆刷大小調整與即時預覽 ---
            const brushSize = document.getElementById('brushSize');
            const brushValText = document.getElementById('brushValText');
            const brushPreviewDot = document.getElementById('brushPreviewDot');

            function updateBrushPreview() {
                if (brushValText) brushValText.textContent = `${currentLineWidth}px`;
                if (brushPreviewDot) {
                    const previewSize = Math.max(4, Math.min(22, currentLineWidth));
                    brushPreviewDot.style.width = `${previewSize}px`;
                    brushPreviewDot.style.height = `${previewSize}px`;
                    brushPreviewDot.style.background = currentColor;
                }
            }

            if (brushSize) {
                brushSize.addEventListener('input', (e) => {
                    currentLineWidth = parseInt(e.target.value, 10);
                    updateBrushPreview();
                });
                updateBrushPreview();
            }

            // --- 動作：復原 (Undo) ---
            const undoBtn = document.getElementById('undoCanvasBtn');
            if (undoBtn) {
                undoBtn.addEventListener('click', undo);
            }

            // 鍵盤 Ctrl+Z 復原快捷鍵
            window.addEventListener('keydown', (e) => {
                if ((e.ctrlKey || e.metaKey) && (e.key === 'z' || e.key === 'Z')) {
                    if (document.activeElement.tagName !== 'INPUT') {
                        e.preventDefault();
                        undo();
                    }
                }
            });

            // --- 動作：清空 (Clear) ---
            const clearBtn = document.getElementById('clearCanvasBtn');
            if (clearBtn) {
                clearBtn.addEventListener('click', () => {
                    saveHistory();
                    const rect = canvas.getBoundingClientRect();
                    ctx.fillStyle = '#ffffff';
                    ctx.fillRect(0, 0, rect.width, rect.height);
                    if (guidePrompt) guidePrompt.classList.remove('hidden');
                    showToast('畫布已清空');
                });
            }

            // --- 動作：儲存畫作 (Save PNG) ---
            const saveBtn = document.getElementById('saveCanvasBtn');
            if (saveBtn) {
                saveBtn.addEventListener('click', () => {
                    const link = document.createElement('a');
                    link.download = `我的畫畫創作_${new Date().toISOString().slice(0, 10)}.png`;
                    link.href = canvas.toDataURL('image/png');
                    link.click();
                    showToast('畫作已成功下載！');
                });
            }
        })();

        // ==========================================================================
        // === 6. 背景視覺風格排版控制器 (Segmented Dock Background Controller) ===
        // ==========================================================================
        (function () {
            const dockPills = document.querySelectorAll('.bg-dock-pill');
            const bgModes = {
                aurora: document.getElementById('bgModeAurora'),
                stars: document.getElementById('bgStarsCanvas'),
                cyber: document.getElementById('bgModeCyber'),
                geometry: document.getElementById('bgModeGeometry'),
                sakura: document.getElementById('bgSakuraCanvas')
            };

            const bgNames = {
                aurora: '靈動流體極光',
                stars: '互動星空粒子',
                cyber: '賽博霓虹網格',
                geometry: '現代立體幾何',
                sakura: '唯美落櫻流光'
            };

            let currentBgStyle = localStorage.getItem('user-bg-style') || 'aurora';
            let starsAnimationId = null;
            let sakuraAnimationId = null;

            function applyBgStyle(styleKey) {
                if (!bgModes[styleKey]) styleKey = 'aurora';
                currentBgStyle = styleKey;
                localStorage.setItem('user-bg-style', styleKey);

                // 更新排版列 Pills 的 active 樣式
                dockPills.forEach(pill => {
                    const bg = pill.getAttribute('data-bg');
                    pill.classList.toggle('active', bg === styleKey);
                });

                // 更新背景層 active
                Object.keys(bgModes).forEach(key => {
                    if (bgModes[key]) {
                        if (key === styleKey) {
                            bgModes[key].classList.add('active');
                        } else {
                            bgModes[key].classList.remove('active');
                        }
                    }
                });

                // 啟動或關閉 Canvas 循環以省電省效能
                if (styleKey === 'stars') {
                    startStarsEngine();
                } else {
                    stopStarsEngine();
                }

                if (styleKey === 'sakura') {
                    startSakuraEngine();
                } else {
                    stopSakuraEngine();
                }
            }

            dockPills.forEach(pill => {
                pill.addEventListener('click', () => {
                    const styleKey = pill.getAttribute('data-bg');
                    applyBgStyle(styleKey);
                    showToast(`背景已切換為「${bgNames[styleKey]}」`);
                });
            });

            // --- Canvas 引擎 1: 互動星空粒子 ---
            const starsCanvas = document.getElementById('bgStarsCanvas');
            let starsCtx = starsCanvas ? starsCanvas.getContext('2d') : null;
            let starsParticles = [];
            let starsMouse = { x: -9999, y: -9999, radius: 160 };

            function initStars() {
                if (!starsCanvas) return;
                const dpr = Math.min(window.devicePixelRatio || 1, 2);
                const width = window.innerWidth;
                const height = window.innerHeight;
                starsCanvas.width = width * dpr;
                starsCanvas.height = height * dpr;
                starsCanvas.style.width = width + 'px';
                starsCanvas.style.height = height + 'px';
                starsCtx = starsCanvas.getContext('2d');
                starsCtx.scale(dpr, dpr);

                const count = Math.min(Math.floor((width * height) / 11000), 100);
                starsParticles = [];

                for (let i = 0; i < count; i++) {
                    starsParticles.push({
                        x: Math.random() * width,
                        y: Math.random() * height,
                        vx: (Math.random() - 0.5) * 0.7,
                        vy: (Math.random() - 0.5) * 0.7,
                        radius: Math.random() * 2 + 0.8,
                        alpha: Math.random() * 0.6 + 0.3,
                        twinkleSpeed: Math.random() * 0.03 + 0.01,
                        twinklePhase: Math.random() * Math.PI * 2
                    });
                }
            }

            function drawStars() {
                if (!starsCtx) return;
                const width = window.innerWidth;
                const height = window.innerHeight;
                starsCtx.clearRect(0, 0, width, height);

                const isLight = document.documentElement.getAttribute('data-theme') === 'light';
                const particleColor = isLight ? 'rgba(99, 102, 241, ' : 'rgba(0, 240, 255, ';
                const lineColor = isLight ? 'rgba(99, 102, 241, ' : 'rgba(131, 56, 236, ';

                for (let i = 0; i < starsParticles.length; i++) {
                    const p = starsParticles[i];
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0) p.x = width;
                    if (p.x > width) p.x = 0;
                    if (p.y < 0) p.y = height;
                    if (p.y > height) p.y = 0;

                    p.twinklePhase += p.twinkleSpeed;
                    const dynamicAlpha = Math.max(0.1, p.alpha + Math.sin(p.twinklePhase) * 0.25);

                    starsCtx.beginPath();
                    starsCtx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    starsCtx.fillStyle = particleColor + dynamicAlpha + ')';
                    starsCtx.fill();

                    for (let j = i + 1; j < starsParticles.length; j++) {
                        const p2 = starsParticles[j];
                        const dx = p.x - p2.x;
                        const dy = p.y - p2.y;
                        const dist = Math.sqrt(dx * dx + dy * dy);

                        if (dist < 120) {
                            const lineAlpha = (1 - dist / 120) * 0.35;
                            starsCtx.beginPath();
                            starsCtx.moveTo(p.x, p.y);
                            starsCtx.lineTo(p2.x, p2.y);
                            starsCtx.strokeStyle = lineColor + lineAlpha + ')';
                            starsCtx.lineWidth = 0.8;
                            starsCtx.stroke();
                        }
                    }

                    // 滑鼠互動連線
                    const mouseDx = p.x - starsMouse.x;
                    const mouseDy = p.y - starsMouse.y;
                    const mouseDist = Math.sqrt(mouseDx * mouseDx + mouseDy * mouseDy);

                    if (mouseDist < starsMouse.radius) {
                        const mouseLineAlpha = (1 - mouseDist / starsMouse.radius) * 0.7;
                        starsCtx.beginPath();
                        starsCtx.moveTo(p.x, p.y);
                        starsCtx.lineTo(starsMouse.x, starsMouse.y);
                        starsCtx.strokeStyle = (isLight ? 'rgba(255, 77, 109, ' : 'rgba(0, 240, 255, ') + mouseLineAlpha + ')';
                        starsCtx.lineWidth = 1.3;
                        starsCtx.stroke();
                    }
                }

                starsAnimationId = requestAnimationFrame(drawStars);
            }

            function startStarsEngine() {
                if (!starsAnimationId) {
                    initStars();
                    drawStars();
                }
            }

            function stopStarsEngine() {
                if (starsAnimationId) {
                    cancelAnimationFrame(starsAnimationId);
                    starsAnimationId = null;
                }
            }

            window.addEventListener('mousemove', (e) => {
                starsMouse.x = e.clientX;
                starsMouse.y = e.clientY;
            });

            window.addEventListener('mouseleave', () => {
                starsMouse.x = -9999;
                starsMouse.y = -9999;
            });

            // --- Canvas 引擎 2: 唯美落櫻流光 ---
            const sakuraCanvas = document.getElementById('bgSakuraCanvas');
            let sakuraCtx = sakuraCanvas ? sakuraCanvas.getContext('2d') : null;
            let sakuraPetals = [];

            function initSakura() {
                if (!sakuraCanvas) return;
                const dpr = Math.min(window.devicePixelRatio || 1, 2);
                const width = window.innerWidth;
                const height = window.innerHeight;
                sakuraCanvas.width = width * dpr;
                sakuraCanvas.height = height * dpr;
                sakuraCanvas.style.width = width + 'px';
                sakuraCanvas.style.height = height + 'px';
                sakuraCtx = sakuraCanvas.getContext('2d');
                sakuraCtx.scale(dpr, dpr);

                const count = Math.min(Math.floor((width * height) / 22000), 50);
                sakuraPetals = [];

                for (let i = 0; i < count; i++) {
                    sakuraPetals.push({
                        x: Math.random() * width,
                        y: Math.random() * height,
                        size: Math.random() * 9 + 8,
                        vx: Math.random() * 1.5 + 0.8,
                        vy: Math.random() * 1.2 + 0.8,
                        rotation: Math.random() * 360,
                        rotSpeed: (Math.random() - 0.5) * 2,
                        flip: Math.random() * Math.PI,
                        flipSpeed: Math.random() * 0.03 + 0.01,
                        alpha: Math.random() * 0.45 + 0.45,
                        color: Math.random() > 0.3 ? '#ffb7c5' : '#ff758c'
                    });
                }

                for (let i = 0; i < 25; i++) {
                    sakuraPetals.push({
                        isEmber: true,
                        x: Math.random() * width,
                        y: Math.random() * height,
                        radius: Math.random() * 2 + 1,
                        vx: Math.random() * 0.8 + 0.2,
                        vy: Math.random() * 0.6 + 0.3,
                        alpha: Math.random() * 0.6 + 0.2,
                        pulse: Math.random() * Math.PI * 2
                    });
                }
            }

            function drawSakura() {
                if (!sakuraCtx) return;
                const width = window.innerWidth;
                const height = window.innerHeight;
                sakuraCtx.clearRect(0, 0, width, height);

                const isLight = document.documentElement.getAttribute('data-theme') === 'light';

                sakuraPetals.forEach(p => {
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.isEmber) {
                        p.pulse += 0.04;
                        const pulseAlpha = Math.max(0.1, p.alpha + Math.sin(p.pulse) * 0.25);
                        sakuraCtx.beginPath();
                        sakuraCtx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                        sakuraCtx.fillStyle = isLight ? `rgba(255, 158, 0, ${pulseAlpha * 0.8})` : `rgba(255, 209, 102, ${pulseAlpha})`;
                        sakuraCtx.fill();
                    } else {
                        p.rotation += p.rotSpeed;
                        p.flip += p.flipSpeed;

                        sakuraCtx.save();
                        sakuraCtx.translate(p.x, p.y);
                        sakuraCtx.rotate((p.rotation * Math.PI) / 180);
                        sakuraCtx.scale(1, Math.cos(p.flip));

                        sakuraCtx.beginPath();
                        sakuraCtx.moveTo(0, 0);
                        sakuraCtx.bezierCurveTo(p.size / 2, -p.size / 2, p.size, 0, 0, p.size * 1.3);
                        sakuraCtx.bezierCurveTo(-p.size, 0, -p.size / 2, -p.size / 2, 0, 0);

                        sakuraCtx.fillStyle = p.color;
                        sakuraCtx.globalAlpha = p.alpha;
                        sakuraCtx.shadowColor = 'rgba(255, 117, 140, 0.4)';
                        sakuraCtx.shadowBlur = 8;
                        sakuraCtx.fill();
                        sakuraCtx.restore();
                    }

                    if (p.y > height + 20) {
                        p.y = -20;
                        p.x = Math.random() * width;
                    }
                    if (p.x > width + 20) {
                        p.x = -20;
                    }
                });

                sakuraAnimationId = requestAnimationFrame(drawSakura);
            }

            function startSakuraEngine() {
                if (!sakuraAnimationId) {
                    initSakura();
                    drawSakura();
                }
            }

            function stopSakuraEngine() {
                if (sakuraAnimationId) {
                    cancelAnimationFrame(sakuraAnimationId);
                    sakuraAnimationId = null;
                }
            }

            let resizeTimer;
            window.addEventListener('resize', () => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(() => {
                    if (currentBgStyle === 'stars') initStars();
                    if (currentBgStyle === 'sakura') initSakura();
                }, 100);
            });

            const themeObserver = new MutationObserver(() => {
                if (currentBgStyle === 'stars') initStars();
                if (currentBgStyle === 'sakura') initSakura();
            });
            themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

            applyBgStyle(currentBgStyle);
        })();
    </script>
</body>

