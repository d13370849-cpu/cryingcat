<!DOCTYPE html>
<html lang="zh-Hant">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>個人簡介與作品集 | 臺南應用科技大學 多媒體動畫科系</title>
    <!-- Google Fonts 引入現代字體 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&family=Outfit:wght@400;600;800;900&display=swap"
        rel="stylesheet">
    <!-- Font Awesome 圖標庫 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* === 核心色彩變數與主題設計 === */
        :root {
            --bg-gradient: radial-gradient(circle at 10% 20%, rgba(255, 77, 109, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(131, 56, 236, 0.18) 0%, transparent 40%),
                radial-gradient(circle at 50% 50%, rgba(17, 138, 178, 0.12) 0%, transparent 60%),
                #0a0e17;
            --card-bg: rgba(22, 27, 46, 0.75);
            --card-border: rgba(255, 255, 255, 0.12);
            --card-shadow: 0 20px 45px -15px rgba(0, 0, 0, 0.6);
            --text-main: #f1f5f9;
            --text-muted: #94a3b8;
            --item-bg: rgba(255, 255, 255, 0.04);
            --item-border: rgba(255, 255, 255, 0.08);

            /* 質感特色色彩 */
            --color-red: #ff4d6d;
            --color-orange: #ff9e00;
            --color-yellow: #ffd166;
            --color-green: #06d6a0;
            --color-blue: #118ab2;
            --color-purple: #8338ec;
            --color-cyan: #00f0ff;

            --radius-lg: 24px;
            --radius-md: 16px;
            --radius-sm: 10px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* 淺色主題變數 */
        [data-theme="light"] {
            --bg-gradient: radial-gradient(circle at 10% 20%, rgba(255, 77, 109, 0.1) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(131, 56, 236, 0.1) 0%, transparent 40%),
                radial-gradient(circle at 50% 50%, rgba(17, 138, 178, 0.08) 0%, transparent 60%),
                #f0f4f8;
            --card-bg: rgba(255, 255, 255, 0.88);
            --card-border: rgba(255, 255, 255, 0.85);
            --card-shadow: 0 20px 40px -15px rgba(100, 116, 139, 0.22);
            --text-main: #0f172a;
            --text-muted: #64748b;
            --item-bg: rgba(255, 255, 255, 0.75);
            --item-border: rgba(226, 232, 240, 0.85);
        }

        /* === 全局重設 === */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        html {
            background-color: #070a13;
            min-height: 100%;
            scroll-behavior: smooth;
        }

        [data-theme="light"] html {
            background-color: #f1f5f9;
        }

        body {
            font-family: 'Outfit', 'Noto Sans TC', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-gradient);
            background-attachment: fixed;
            background-size: cover;
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 24px 16px 60px;
            transition: var(--transition);
            overflow-x: hidden;
            position: relative;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* ==========================================================================
           === 頂級動態美學背景系統樣式 (Comprehensive Dynamic Background System) ===
           ========================================================================== */
        .bg-system {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: -1;
            overflow: hidden;
            transform: translateZ(0);
        }

        .bg-mode {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.8s ease;
            will-change: opacity;
        }

        .bg-mode.active {
            opacity: 1;
            visibility: visible;
        }

        .bg-mode-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: block;
        }

        /* --- 風格 1: 靈動流體極光 (Aurora Fluid Mesh) --- */
        .bg-mode-aurora {
            background: radial-gradient(circle at 50% 50%, rgba(131, 56, 236, 0.08) 0%, transparent 70%);
        }

        .aurora-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(85px);
            opacity: 0.55;
            mix-blend-mode: screen;
            will-change: transform;
        }

        [data-theme="light"] .aurora-orb {
            opacity: 0.4;
            filter: blur(95px);
            mix-blend-mode: multiply;
        }

        .orb-1 {
            width: 550px;
            height: 550px;
            background: radial-gradient(circle, #8338ec 0%, rgba(131, 56, 236, 0) 70%);
            top: -10%;
            left: -10%;
            animation: auroraFloat1 22s ease-in-out infinite alternate;
        }

        .orb-2 {
            width: 620px;
            height: 620px;
            background: radial-gradient(circle, #ff4d6d 0%, rgba(255, 77, 109, 0) 70%);
            bottom: -15%;
            right: -10%;
            animation: auroraFloat2 26s ease-in-out infinite alternate;
        }

        .orb-3 {
            width: 480px;
            height: 480px;
            background: radial-gradient(circle, #00f0ff 0%, rgba(0, 240, 255, 0) 70%);
            top: 35%;
            left: 60%;
            animation: auroraFloat3 18s ease-in-out infinite alternate;
        }

        .orb-4 {
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, #ff9e00 0%, rgba(255, 158, 0, 0) 70%);
            bottom: 20%;
            left: 10%;
            animation: auroraFloat4 24s ease-in-out infinite alternate;
        }

        @keyframes auroraFloat1 {
            0% {
                transform: translate(0, 0) scale(1);
            }

            50% {
                transform: translate(120px, 80px) scale(1.15);
            }

            100% {
                transform: translate(-60px, 140px) scale(0.9);
            }
        }

        @keyframes auroraFloat2 {
            0% {
                transform: translate(0, 0) scale(1);
            }

            50% {
                transform: translate(-140px, -100px) scale(1.2);
            }

            100% {
                transform: translate(80px, -60px) scale(0.95);
            }
        }

        @keyframes auroraFloat3 {
            0% {
                transform: translate(0, 0) scale(1);
            }

            50% {
                transform: translate(-100px, 120px) scale(1.1);
            }

            100% {
                transform: translate(110px, -70px) scale(0.85);
            }
        }

        @keyframes auroraFloat4 {
            0% {
                transform: translate(0, 0) scale(1);
            }

            50% {
                transform: translate(90px, -110px) scale(1.18);
            }

            100% {
                transform: translate(-110px, 60px) scale(0.92);
            }
        }

        /* --- 風格 3: 賽博霓虹地平線網格 (Cyberpunk 3D Synthwave Grid) --- */
        .bg-mode-cyber {
            background: radial-gradient(circle at 50% 30%, #1a082e 0%, #080410 70%);
            perspective: 700px;
            perspective-origin: 50% 50%;
            overflow: hidden;
        }

        [data-theme="light"] .bg-mode-cyber {
            background: radial-gradient(circle at 50% 30%, #ede4f7 0%, #d8e2f0 70%);
        }

        .cyber-sun {
            position: absolute;
            top: 16%;
            left: 50%;
            transform: translateX(-50%);
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: linear-gradient(to bottom, #ffe600 0%, #ff007f 65%, #7928ca 100%);
            box-shadow: 0 0 60px rgba(255, 0, 127, 0.65), 0 0 120px rgba(255, 230, 0, 0.4);
            mask-image: linear-gradient(to bottom,
                    black 0%, black 50%,
                    transparent 50%, transparent 54%,
                    black 54%, black 63%,
                    transparent 63%, transparent 68%,
                    black 68%, black 77%,
                    transparent 77%, transparent 83%,
                    black 83%, black 91%,
                    transparent 91%, transparent 98%,
                    black 98%, black 100%);
            -webkit-mask-image: linear-gradient(to bottom,
                    black 0%, black 50%,
                    transparent 50%, transparent 54%,
                    black 54%, black 63%,
                    transparent 63%, transparent 68%,
                    black 68%, black 77%,
                    transparent 77%, transparent 83%,
                    black 83%, black 91%,
                    transparent 91%, transparent 98%,
                    black 98%, black 100%);
            animation: sunPulse 4s ease-in-out infinite alternate;
        }

        @keyframes sunPulse {
            0% {
                transform: translateX(-50%) scale(1);
                filter: drop-shadow(0 0 25px rgba(255, 0, 127, 0.6));
            }

            100% {
                transform: translateX(-50%) scale(1.05);
                filter: drop-shadow(0 0 45px rgba(255, 0, 127, 0.85));
            }
        }

        .cyber-horizon-beam {
            position: absolute;
            top: 50%;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, transparent 0%, #00f0ff 25%, #ff007f 50%, #00f0ff 75%, transparent 100%);
            box-shadow: 0 0 25px 4px #00f0ff, 0 0 50px 8px #ff007f;
            z-index: 2;
        }

        .cyber-grid-plane {
            position: absolute;
            top: 50%;
            left: -50%;
            width: 200%;
            height: 100%;
            transform-origin: 50% 0%;
            transform: rotateX(76deg);
            background-image:
                linear-gradient(rgba(0, 240, 255, 0.45) 1.5px, transparent 1.5px),
                linear-gradient(90deg, rgba(255, 0, 127, 0.45) 1.5px, transparent 1.5px);
            background-size: 50px 50px;
            animation: cyberGridMove 1.6s linear infinite;
            mask-image: linear-gradient(to bottom, black 0%, rgba(0, 0, 0, 0.9) 40%, transparent 90%);
            -webkit-mask-image: linear-gradient(to bottom, black 0%, rgba(0, 0, 0, 0.9) 40%, transparent 90%);
        }

        [data-theme="light"] .cyber-grid-plane {
            background-image:
                linear-gradient(rgba(17, 138, 178, 0.35) 1.5px, transparent 1.5px),
                linear-gradient(90deg, rgba(131, 56, 236, 0.35) 1.5px, transparent 1.5px);
        }

        @keyframes cyberGridMove {
            0% {
                background-position: 0 0;
            }

            100% {
                background-position: 0 50px;
            }
        }

        /* --- 風格 4: 現代立體懸浮幾何 (Floating 3D Glass Geometry) --- */
        .bg-mode-geometry {
            perspective: 1000px;
            overflow: hidden;
            background: radial-gradient(circle at 20% 80%, rgba(131, 56, 236, 0.12) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(0, 240, 255, 0.12) 0%, transparent 50%);
        }

        .geo-shape {
            position: absolute;
            border-radius: var(--radius-md);
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.22);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25), inset 0 1px 1px rgba(255, 255, 255, 0.5);
            transform-style: preserve-3d;
            will-change: transform;
        }

        [data-theme="light"] .geo-shape {
            background: rgba(255, 255, 255, 0.45);
            border: 1px solid rgba(255, 255, 255, 0.85);
            box-shadow: 0 15px 35px rgba(100, 116, 139, 0.15), inset 0 1px 1px #ffffff;
        }

        .geo-ring-1 {
            width: 200px;
            height: 200px;
            border-radius: 50%;
            border: 24px solid rgba(131, 56, 236, 0.3);
            border-top-color: rgba(255, 77, 109, 0.6);
            background: transparent;
            top: 12%;
            left: 8%;
            animation: geoFloatRing 18s ease-in-out infinite alternate;
        }

        .geo-cube-1 {
            width: 130px;
            height: 130px;
            top: 65%;
            left: 12%;
            background: linear-gradient(135deg, rgba(255, 158, 0, 0.25), rgba(255, 77, 109, 0.15));
            border-color: rgba(255, 158, 0, 0.4);
            animation: geoFloatCube 20s ease-in-out infinite alternate;
        }

        .geo-sphere-1 {
            width: 170px;
            height: 170px;
            border-radius: 50%;
            top: 18%;
            right: 10%;
            background: radial-gradient(circle at 35% 35%, rgba(0, 240, 255, 0.45), rgba(17, 138, 178, 0.15) 70%, transparent 100%);
            border: 1px solid rgba(0, 240, 255, 0.5);
            box-shadow: 0 0 35px rgba(0, 240, 255, 0.35);
            animation: geoFloatSphere 16s ease-in-out infinite alternate;
        }

        .geo-triangle-1 {
            width: 140px;
            height: 140px;
            top: 48%;
            right: 14%;
            clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
            background: linear-gradient(135deg, rgba(6, 214, 160, 0.35), rgba(17, 138, 178, 0.15));
            border: none;
            animation: geoFloatTriangle 22s ease-in-out infinite alternate;
        }

        .geo-pill-1 {
            width: 180px;
            height: 80px;
            border-radius: 50px;
            bottom: 10%;
            right: 25%;
            background: linear-gradient(135deg, rgba(131, 56, 236, 0.28), rgba(0, 240, 255, 0.2));
            border-color: rgba(131, 56, 236, 0.45);
            animation: geoFloatPill 19s ease-in-out infinite alternate;
        }

        .geo-diamond-1 {
            width: 110px;
            height: 110px;
            top: 40%;
            left: 20%;
            transform: rotate(45deg);
            background: linear-gradient(135deg, rgba(255, 209, 102, 0.3), rgba(255, 117, 140, 0.2));
            border-color: rgba(255, 209, 102, 0.5);
            animation: geoFloatDiamond 17s ease-in-out infinite alternate;
        }

        @keyframes geoFloatRing {
            0% {
                transform: translateY(0) rotate(0deg) scale(1);
            }

            100% {
                transform: translateY(-40px) rotate(180deg) scale(1.08);
            }
        }

        @keyframes geoFloatCube {
            0% {
                transform: rotateX(25deg) rotateY(20deg) translateY(0);
            }

            100% {
                transform: rotateX(45deg) rotateY(60deg) translateY(-50px);
            }
        }

        @keyframes geoFloatSphere {
            0% {
                transform: translateY(0) scale(1);
            }

            100% {
                transform: translateY(-45px) scale(1.1);
            }
        }

        @keyframes geoFloatTriangle {
            0% {
                transform: rotate(0deg) translateY(0);
            }

            100% {
                transform: rotate(35deg) translateY(-35px);
            }
        }

        @keyframes geoFloatPill {
            0% {
                transform: rotate(-15deg) translateY(0);
            }

            100% {
                transform: rotate(15deg) translateY(-40px);
            }
        }

        @keyframes geoFloatDiamond {
            0% {
                transform: rotate(45deg) translateY(0);
            }

            100% {
                transform: rotate(75deg) translateY(-30px);
            }
        }

        /* --- 全局微暗角與氛圍層 --- */
        .bg-vignette {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 50% 50%, transparent 55%, rgba(0, 0, 0, 0.45) 100%);
            pointer-events: none;
            z-index: 10;
        }

        [data-theme="light"] .bg-vignette {
            background: radial-gradient(circle at 50% 50%, transparent 60%, rgba(100, 116, 139, 0.12) 100%);
        }


        /* === 主容器 (毛玻璃卡片) === */
        .profile-container {
            width: 100%;
            max-width: 960px;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: var(--radius-lg);
            backdrop-filter: blur(28px) saturate(180%);
            -webkit-backdrop-filter: blur(28px) saturate(180%);
            box-shadow: var(--card-shadow), inset 0 1px 0 rgba(255, 255, 255, 0.14);
            padding: 45px;
            position: relative;
            overflow: hidden;
            animation: fadeIn 0.8s ease-out;
        }

        /* 背景流動裝飾光暈 */
        .profile-container::before {
            content: '';
            position: absolute;
            top: -120px;
            right: -100px;
            width: 300px;
            height: 300px;
            background: linear-gradient(135deg, var(--color-purple), var(--color-red));
            border-radius: 50%;
            filter: blur(90px);
            opacity: 0.22;
            pointer-events: none;
        }

        .profile-container::after {
            content: '';
            position: absolute;
            bottom: -120px;
            left: -100px;
            width: 300px;
            height: 300px;
            background: linear-gradient(135deg, var(--color-blue), var(--color-green));
            border-radius: 50%;
            filter: blur(90px);
            opacity: 0.22;
            pointer-events: none;
        }

        /* === 英雄區塊：頭像與主標題 === */
        .hero-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin-bottom: 35px;
            position: relative;
            z-index: 1;
        }

        .avatar-wrapper {
            position: relative;
            width: 160px;
            height: 160px;
            margin-bottom: 20px;
        }

        .avatar-glow {
            position: absolute;
            inset: -4px;
            background: linear-gradient(45deg, var(--color-red), var(--color-orange), var(--color-green), var(--color-blue), var(--color-purple));
            border-radius: 50%;
            filter: blur(8px);
            opacity: 0.75;
            animation: rotateGlow 6s linear infinite;
        }

        .avatar-img {
            position: relative;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid var(--card-bg);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
            transition: var(--transition);
            cursor: pointer;
        }

        .avatar-img:hover {
            transform: scale(1.05) rotate(3deg);
        }

        .status-badge {
            position: absolute;
            bottom: 6px;
            right: 0;
            background: linear-gradient(135deg, #10b981, #059669);
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 20px;
            border: 2px solid var(--card-bg);
            display: flex;
            align-items: center;
            gap: 5px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
            white-space: nowrap;
        }

        .status-badge .dot {
            width: 7px;
            height: 7px;
            background: #ffffff;
            border-radius: 50%;
            animation: pulse 1.5s infinite;
        }

        .main-title {
            font-size: 2.7rem;
            font-weight: 900;
            letter-spacing: 2px;
            background: linear-gradient(135deg, #ffffff 0%, #e2e8f0 50%, #94a3b8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
        }

        [data-theme="light"] .main-title {
            background: linear-gradient(135deg, #0f172a 0%, #334155 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .sub-tagline {
            font-size: 1.05rem;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 14px;
        }

        .hero-tags {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 8px;
            margin-top: 6px;
        }

        .hero-tag {
            background: var(--item-bg);
            border: 1px solid var(--item-border);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            color: var(--text-muted);
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        /* === 關於我 (About Me) 專區 === */
        .about-me-section {
            background: linear-gradient(135deg, rgba(131, 56, 236, 0.12), rgba(17, 138, 178, 0.08));
            border: 1px solid rgba(131, 56, 236, 0.3);
            border-radius: var(--radius-md);
            padding: 28px 30px;
            margin-bottom: 30px;
            position: relative;
            z-index: 1;
            box-shadow: 0 10px 30px -10px rgba(131, 56, 236, 0.15);
        }

        .about-me-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .about-me-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.3rem;
            font-weight: 800;
            color: var(--text-main);
        }

        .about-me-badge {
            background: linear-gradient(135deg, var(--color-purple), var(--color-blue));
            color: #fff;
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .about-me-content {
            font-size: 1.08rem;
            line-height: 1.85;
            color: var(--text-main);
            position: relative;
            padding-left: 20px;
            border-left: 3px solid var(--color-purple);
        }

        .about-me-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 18px;
            padding-top: 14px;
            border-top: 1px dashed var(--item-border);
        }

        .about-pill {
            background: var(--item-bg);
            border: 1px solid var(--item-border);
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-muted);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .about-pill i {
            color: var(--color-purple);
        }

        /* === 資訊網格區 (四項重點資訊) === */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 35px;
            position: relative;
            z-index: 1;
        }

        .info-card {
            background: var(--item-bg);
            border: 1px solid var(--item-border);
            border-radius: var(--radius-md);
            padding: 18px 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }

        .info-card:hover {
            transform: translateY(-3px);
            background: rgba(255, 255, 255, 0.08);
            box-shadow: 0 10px 22px -8px rgba(0, 0, 0, 0.35);
        }

        /* 特色光條 */
        .info-card::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: var(--accent-color);
            border-radius: 4px 0 0 4px;
        }

        .icon-box {
