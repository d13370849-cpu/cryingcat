        .card-edu {
            --accent-color: var(--color-yellow);
        }

        .card-hobby {
            --accent-color: var(--color-green);
        }

        .card-skill {
            --accent-color: var(--color-blue);
        }

        .card-contact {
            --accent-color: var(--color-purple);
        }

        /* === 區塊共同樣式 === */
        .section-block {
            background: var(--item-bg);
            border: 1px solid var(--item-border);
            border-radius: var(--radius-md);
            padding: 30px;
            margin-bottom: 35px;
            position: relative;
            z-index: 1;
        }

        .block-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .block-title-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .block-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.35rem;
            font-weight: 800;
            color: var(--text-main);
        }

        .block-subtitle {
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        /* === 專長技能區塊 (互動式軟體熟練度量表卡片網格) === */
        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 18px;
        }

        .skill-bar-card {
            background: var(--item-bg);
            border: 1px solid var(--item-border);
            border-radius: var(--radius-md);
            padding: 20px 22px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }

        .skill-bar-card:hover {
            transform: translateY(-3px);
            background: rgba(255, 255, 255, 0.08);
            box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.35);
            border-color: var(--skill-accent, var(--color-blue));
        }

        .skill-bar-card::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: var(--skill-accent, var(--color-blue));
            border-radius: 4px 0 0 4px;
        }

        .skill-card-procreate {
            --skill-accent: #ec4899;
        }

        .skill-card-ai {
            --skill-accent: #ff9a00;
        }

        .skill-card-ps {
            --skill-accent: #31a8ff;
        }

        .skill-card-pr {
            --skill-accent: #818cf8;
        }

        .skill-card-blender {
            --skill-accent: #f97316;
        }

        .skill-card-maya {
            --skill-accent: #00f0ff;
        }

        .skill-info {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .skill-name-group {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .skill-title-text {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .software-icon-badge {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 15px;
            color: #fff;
            flex-shrink: 0;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
        }

        .icon-procreate {
            background: linear-gradient(135deg, #181818, #333333);
            border: 1px solid #444;
        }

        .icon-ai {
            background: #330000;
            color: #ff9a00;
            border: 1px solid #ff9a00;
            font-family: monospace;
        }

        .icon-ps {
            background: #001e36;
            color: #31a8ff;
            border: 1px solid #31a8ff;
            font-family: monospace;
        }

        .icon-pr {
            background: #00005b;
            color: #9999ff;
            border: 1px solid #9999ff;
            font-family: monospace;
        }

        .icon-blender {
            background: #ea7600;
            color: #ffffff;
        }

        .icon-maya {
            background: #00222a;
            color: #00f0ff;
            border: 1px solid #00f0ff;
            font-family: 'Outfit', sans-serif;
            font-weight: 900;
        }

        .skill-desc {
            font-size: 0.82rem;
            color: var(--text-muted);
            margin-top: 2px;
        }

        .skill-level-number {
            font-size: 0.88rem;
            font-weight: 800;
            color: var(--text-muted);
            background: rgba(255, 255, 255, 0.05);
            padding: 4px 10px;
            border-radius: 20px;
            white-space: nowrap;
        }

        .progress-track {
            height: 10px;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            overflow: hidden;
            position: relative;
        }

        .progress-fill {
            height: 100%;
            border-radius: 10px;
            position: relative;
            transition: width 1.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .fill-procreate {
            width: 80%;
            background: linear-gradient(90deg, #a855f7, #ec4899);
        }

        .fill-ai {
            width: 80%;
            background: linear-gradient(90deg, #ff9e00, #ffd166);
        }

        .fill-ps {
            width: 70%;
            background: linear-gradient(90deg, #0284c7, #38bdf8);
        }

        .fill-pr {
            width: 60%;
            background: linear-gradient(90deg, #6366f1, #818cf8);
        }

        .fill-blender {
            width: 50%;
            background: linear-gradient(90deg, #ea580c, #f97316);
        }

        .fill-maya {
            width: 50%;
            background: linear-gradient(90deg, #0284c7, #00f0ff);
        }

        /* === 精選作品區塊 (多圖畫廊展示) === */
        .gallery-filter-bar {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }

        .filter-btn {
            background: var(--item-bg);
            border: 1px solid var(--item-border);
            color: var(--text-muted);
            padding: 8px 18px;
            border-radius: 30px;
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
        }

        .filter-btn:hover {
            color: var(--text-main);
            background: rgba(255, 255, 255, 0.08);
            border-color: var(--color-purple);
        }

        .filter-btn.active {
            background: linear-gradient(135deg, var(--color-purple), var(--color-blue));
            color: #ffffff;
            border-color: transparent;
            box-shadow: 0 4px 15px rgba(131, 56, 236, 0.35);
        }

        .portfolio-gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
            gap: 22px;
        }

        .gallery-card {
            background: var(--item-bg);
            border: 1px solid var(--item-border);
            border-radius: var(--radius-md);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: var(--transition);
            cursor: pointer;
            position: relative;
        }

        .gallery-card:hover {
            transform: translateY(-5px);
            border-color: var(--color-purple);
            box-shadow: 0 16px 35px -10px rgba(131, 56, 236, 0.35);
        }

        .gallery-img-wrap {
            position: relative;
            width: 100%;
            height: 220px;
            overflow: hidden;
            background: rgba(0, 0, 0, 0.3);
        }

        .gallery-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center top;
            transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            display: block;
        }

        .gallery-card:hover .gallery-img {
            transform: scale(1.06);
        }

        .gallery-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(10, 14, 23, 0.85) 0%, transparent 60%);
            display: flex;
            align-items: flex-end;
            justify-content: flex-end;
            padding: 14px;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .gallery-card:hover .gallery-overlay {
            opacity: 1;
        }

        .gallery-zoom-badge {
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(8px);
            color: #ffffff;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            border: 1px solid rgba(255, 255, 255, 0.4);
            transition: var(--transition);
        }

        .gallery-card:hover .gallery-zoom-badge {
            transform: scale(1.1);
            background: var(--color-purple);
            border-color: var(--color-purple);
        }

        .gallery-content {
            padding: 18px 20px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            flex-grow: 1;
        }

        .gallery-tag-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .gallery-category-pill {
            font-size: 0.72rem;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 20px;
            background: rgba(131, 56, 236, 0.15);
            color: #c084fc;
            border: 1px solid rgba(131, 56, 236, 0.3);
            text-transform: uppercase;
        }

        .gallery-card-title {
            font-size: 1.08rem;
            font-weight: 800;
            color: var(--text-main);
            line-height: 1.4;
        }

        .gallery-card-desc {
            font-size: 0.85rem;
            color: var(--text-muted);
            line-height: 1.5;
        }

        .gallery-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: auto;
            padding-top: 10px;
        }

        .gallery-chip {
            font-size: 0.75rem;
            color: var(--text-muted);
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--item-border);
            padding: 2px 8px;
            border-radius: 12px;
        }

        /* === 學習歷程區塊 === */
        .timeline-card {
            background: var(--item-bg);
            border-left: 4px solid var(--color-yellow);
            border-radius: 0 var(--radius-md) var(--radius-md) 0;
            padding: 20px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .timeline-content h3 {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .timeline-dept {
            font-size: 1.05rem;
            color: var(--color-yellow);
            font-weight: 700;
            margin-bottom: 8px;
        }

        .timeline-desc {
            font-size: 0.92rem;
            color: var(--text-muted);
            line-height: 1.6;
        }

        .timeline-tag {
            background: rgba(255, 209, 102, 0.15);
            border: 1px solid rgba(255, 209, 102, 0.4);
            color: var(--color-yellow);
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 0.85rem;
            font-weight: 700;
            white-space: nowrap;
        }

        /* === 與我聯絡 (Contact Me) 專區 === */
        .contact-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 18px;
        }

        .contact-card {
            background: var(--item-bg);
            border: 1px solid var(--item-border);
            border-radius: var(--radius-md);
            padding: 22px;
            display: flex;
            align-items: center;
            gap: 18px;
            transition: var(--transition);
        }

        .contact-card:hover {
            transform: translateY(-3px);
            border-color: var(--card-accent, var(--color-purple));
            box-shadow: 0 10px 25px -8px rgba(0, 0, 0, 0.3);
        }

        .contact-phone {
            --card-accent: var(--color-green);
        }

        .contact-email {
            --card-accent: var(--color-blue);
        }

        .contact-icon-box {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.06);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: var(--card-accent);
            flex-shrink: 0;
        }

        .contact-info {
            flex-grow: 1;
        }

        .contact-type {
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .contact-value {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 10px;
            letter-spacing: 0.5px;
        }

        .contact-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .action-link-btn {
            background: var(--card-accent);
            color: #ffffff;
            text-decoration: none;
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 0.82rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: var(--transition);
            border: none;
            cursor: pointer;
        }

        .action-link-btn:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

        .action-copy-btn {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid var(--item-border);
            color: var(--text-main);
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.82rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: var(--transition);
        }

        .action-copy-btn:hover {
            background: rgba(255, 255, 255, 0.16);
            border-color: var(--card-accent);
            color: var(--card-accent);
        }

        /* === 學校連結區塊 (完整保留兩種連結) === */
        .links-section {
            background: var(--item-bg);
            border: 1px solid var(--item-border);
            border-radius: var(--radius-md);
            padding: 24px;
            margin-bottom: 35px;
            position: relative;
            z-index: 1;
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
            color: var(--text-main);
            font-size: 1.1rem;
            font-weight: 700;
        }

        .link-buttons-group {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
        }

        .tut-link-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 12px 24px;
            border-radius: var(--radius-sm);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            transition: var(--transition);
            border: 1px solid transparent;
        }

        .btn-primary-link {
            background: linear-gradient(135deg, var(--color-blue), var(--color-purple));
            color: #ffffff;
            box-shadow: 0 4px 15px rgba(17, 138, 178, 0.3);
        }

        .btn-primary-link:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(131, 56, 236, 0.4);
            color: #ffffff;
        }

        .btn-secondary-link {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-main);
            border-color: var(--item-border);
        }

        .btn-secondary-link:hover {
            background: rgba(255, 255, 255, 0.12);
            transform: translateY(-2px);
            border-color: var(--color-yellow);
        }

        .link-badge {
            font-size: 0.75rem;
            padding: 2px 8px;
            border-radius: 12px;
            background: rgba(0, 0, 0, 0.2);
            font-weight: normal;
        }

        /* === 互動塗鴉小畫板 === */
        .canvas-section {
            background: var(--item-bg);
            border: 1px solid var(--item-border);
            border-radius: var(--radius-md);
            padding: 25px;
            position: relative;
            z-index: 1;
            margin-bottom: 30px;
        }

        .canvas-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .canvas-title {
            font-size: 1.15rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .canvas-toolbar {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .color-palette {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .color-dot {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid transparent;
            transition: var(--transition);
        }

        .color-dot:hover,
        .color-dot.active {
            transform: scale(1.2);
            border-color: #ffffff;
            box-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
        }

        .custom-color-input {
            width: 26px;
            height: 26px;
            border: none;
            border-radius: 50%;
            cursor: pointer;
            background: transparent;
        }

        .brush-size-wrap {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .brush-slider {
            accent-color: var(--color-purple);
            cursor: pointer;
            width: 80px;
        }

        .canvas-btn {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid var(--item-border);
            color: var(--text-main);
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: var(--transition);
        }

        .canvas-btn:hover {
            background: rgba(255, 255, 255, 0.16);
            transform: translateY(-1px);
        }

        .drawing-canvas {
            width: 100%;
            height: 240px;
            background: #ffffff;
            border-radius: var(--radius-sm);
            box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.15);
            cursor: crosshair;
            display: block;
            touch-action: none;
        }

        /* === 頁尾設計 === */
        .profile-footer {
            text-align: center;
            color: var(--text-muted);
            font-size: 0.88rem;
            display: flex;
            flex-direction: column;
            gap: 6px;
            padding-top: 15px;
        }

        /* === 圖片燈箱 Modal (精選作品查看用) === */
        .lightbox-modal {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.88);
            backdrop-filter: blur(16px);
            z-index: 9999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 24px;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        .lightbox-modal.active {
            opacity: 1;
            pointer-events: auto;
        }

        .lightbox-close-btn {
            position: absolute;
            top: 24px;
            right: 28px;
            background: rgba(255, 255, 255, 0.15);
            border: none;
            color: #ffffff;
            font-size: 24px;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            z-index: 10002;
        }

        .lightbox-close-btn:hover {
            background: var(--color-red);
            transform: scale(1.1);
        }

        .lightbox-nav-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(255, 255, 255, 0.15);
            border: none;
            color: #ffffff;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            cursor: pointer;
            backdrop-filter: blur(8px);
            transition: var(--transition);
            z-index: 10001;
        }

        .lightbox-nav-btn:hover {
            background: var(--color-purple);
            transform: translateY(-50%) scale(1.1);
        }

        .prev-btn {
            left: 24px;
        }

        .next-btn {
            right: 24px;
        }

        .lightbox-image-container {
            max-width: 90vw;
            max-height: 84vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
        }

        .lightbox-img {
            max-width: 100%;
            max-height: 75vh;
            object-fit: contain;
            border-radius: 12px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.2);
            animation: zoomIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .lightbox-caption-box {
            margin-top: 14px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            text-align: center;
        }

        .lightbox-caption-title {
            color: #ffffff;
            font-size: 1.15rem;
            font-weight: 800;
        }

        .lightbox-caption-desc {
            color: #cbd5e1;
            font-size: 0.9rem;
        }

        /* === 複製成功 Toast 提示 === */
        .toast-notification {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(50px);
            background: rgba(16, 185, 129, 0.95);
            backdrop-filter: blur(8px);
            color: #ffffff;
            padding: 12px 24px;
